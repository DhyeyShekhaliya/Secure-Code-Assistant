{
  "name": "secure-code-assistant",
  "displayName": "Secure Code Assistant",
  "description": "Multi-Agent Secure Code Assistant with AI-powered security analysis and code fixes",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onLanguage:json"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "secureCodeAssistant.enhancePrompt",
        "title": "Enhance Prompt (SecureAssistant)"
      },
      {
        "command": "secureCodeAssistant.scanCurrentFile",
        "title": "Scan Current File (SecureAssistant)"
      },
      {
        "command": "secureCodeAssistant.generateReport",
        "title": "Generate Security Report"
      },
      {
        "command": "secureCodeAssistant.toggleReviewer",
        "title": "Toggle Security Reviewer"
      },
      {
        "command": "secureCodeAssistant.showMetrics",
        "title": "Show Security Metrics"
      },
      {
        "command": "secureCodeAssistant.enhancePromptFromSelection",
        "title": "Enhance as Security Prompt"
      },
      {
        "command": "secureCodeAssistant.configureApiKey",
        "title": "Configure Gemini API Key"
      },
      {
        "command": "secureCodeAssistant.reloadApiKey",
        "title": "Reload AI Configuration"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "secureCodeAssistant.enhancePromptFromSelection",
          "when": "editorHasSelection",
          "group": "security@1"
        }
      ],
      "commandPalette": [
        {
          "command": "secureCodeAssistant.enhancePromptFromSelection",
          "when": "editorHasSelection"
        }
      ]
    },
    "configuration": {
      "properties": {
        "secureAssistant.enableReviewer": {
          "type": "boolean",
          "default": true,
          "description": "Enable automatic security code review"
        },
        "secureAssistant.autoApplyFix": {
          "type": "string",
          "enum": ["never", "prompt", "auto"],
          "default": "prompt",
          "description": "Auto-apply security fixes policy"
        },
        "secureAssistant.scanOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Run security scan on file save"
        },
        "secureAssistant.severityThreshold": {
          "type": "string",
          "enum": ["Low", "Medium", "High"],
          "default": "Medium",
          "description": "Minimum severity threshold for showing issues"
        },
        "secureAssistant.geminiApiKey": {
          "type": "string",
          "default": "",
          "description": "Google Gemini API key for AI-powered explanations and prompt enhancement. Get your free key at https://aistudio.google.com/app/apikey"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.104.0",
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "@typescript-eslint/parser": "^8.42.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.25.9",
    "eslint": "^9.34.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@ai-sdk/google": "^2.0.17",
    "ai": "^5.0.56"
  }
}
